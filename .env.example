# CarbonIQ frontend (Vite) environment template.
#
# Copy to `.env` only if you need local overrides. NEVER put secrets here:
# every variable prefixed with VITE_ is compiled into the public browser bundle,
# so only public values (API URLs) belong here. No API keys, JWT secrets or
# database credentials are ever needed by the frontend.
#
# Local development needs no .env file at all. When the page is served from
# localhost/127.0.0.1 and these are unset, the app falls back to:
#   REST API     -> http://localhost:3001/api
#   Socket.IO    -> http://localhost:3001
#
# ── Vercel (production) ──────────────────────────────────────────────────────
# Set these in Vercel: Project → Settings → Environment Variables → Production
# (both are optional — the built-in production defaults already point at the
# deployed Render backend — but setting them makes the target explicit):
#
#   VITE_API_URL=https://carboniq-api-tejaswini.onrender.com/api
#   VITE_SOCKET_URL=https://carboniq-api-tejaswini.onrender.com
#
# VITE_API_URL may be written with or without a trailing "/api"; it is
# normalised to exactly one "/api" segment at build time.

VITE_API_URL=
VITE_SOCKET_URL=

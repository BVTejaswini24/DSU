# CarbonTwin server configuration template.
# Copy to server/.env and fill in real values. server/.env is gitignored – never commit secrets.

PORT=3001
FRONTEND_URL=http://localhost:5173

# REQUIRED – MongoDB Atlas connection string.
# Atlas: Database -> Connect -> Drivers -> copy the URI, replace <user>, <password>, <cluster>
# with your real database user, that user's password, and your cluster host.
# Example format (use your real values, never commit them):
#   MONGO_URI=mongodb+srv://dbuser:REALPASSWORD@cluster0.xxxxx.mongodb.net/carbontwin
# Local MongoDB instead: MONGO_URI=mongodb://127.0.0.1:27017/carbontwin
MONGO_URI=

# Optional – database name used when the URI has no path (defaults to carbontwin)
MONGO_DB=carbontwin

# Optional – DNS resolvers for mongodb+srv:// SRV lookups.
# Auto (unset): keeps the system resolver if it answers SRV, else falls back to 8.8.8.8,8.8.4.4,1.1.1.1.
# DNS_SERVERS=9.9.9.9,1.1.1.1   # force specific resolvers
# DNS_SERVERS=system            # never touch the OS resolver
DNS_SERVERS=

# REQUIRED for auth – any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Optional AI features (app still runs without these, but AI chat/scanner won't work)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional Redis (falls back to in-memory if not set)
REDIS_URL=
